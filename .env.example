# General Settings
PROJECT_NAME="MedAI Studio"
ENV="development"
SECRET_KEY="medai-studio-secret-key-change-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL="sqlite:///./medai_studio.db"
# For Docker/Postgres:
# DATABASE_URL="postgresql+asyncpg://medai:medai123@db:5432/medaistudio"

# Storage
STORAGE_TYPE="local"
LOCAL_STORAGE_DIR="./storage"

# Deployment Ports
API_PORT=8000
FRONTEND_PORT=3000
INFERENCE_PORT=8001
